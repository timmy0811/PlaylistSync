<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PlaylistSync.App.ViewModels"
        x:Class="PlaylistSync.App.Views.PlaylistEditorWindow"
        x:DataType="vm:PlaylistEditorViewModel"
        Title="{Binding Title}"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </Window.KeyBindings>

  <StackPanel Margin="20" Spacing="14">
    <TextBlock Classes="h1" Text="{Binding Title}" />

    <!-- URL -->
    <StackPanel Spacing="4">
      <TextBlock Text="Playlist URL" />
      <TextBox x:Name="UrlBox" Text="{Binding Url}"
               PlaceholderText="https://www.youtube.com/playlist?list=…" />
      <TextBlock Classes="error hint" Text="{Binding UrlError}" IsVisible="{Binding UrlError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CheckText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <ProgressBar IsIndeterminate="True" Width="40" MinWidth="40" VerticalAlignment="Center" IsVisible="{Binding IsChecking}" />
        <TextBlock Classes="hint" Text="{Binding CheckText}" MaxWidth="480"
                   Classes.muted="{Binding !CheckFailed}" Classes.warning="{Binding CheckFailed}" />
      </StackPanel>
    </StackPanel>

    <!-- Name -->
    <StackPanel Spacing="4">
      <TextBlock Text="Name" />
      <TextBox Text="{Binding Name}" PlaceholderText="Filled in from the playlist title" />
      <TextBlock Classes="error hint" Text="{Binding NameError}" IsVisible="{Binding NameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>

    <!-- Folder -->
    <StackPanel Spacing="4">
      <TextBlock Text="Folder" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Text="{Binding Directory}" PlaceholderText="Where the audio files go" />
        <Button Grid.Column="1" Margin="6,0,0,0" Content="Browse…" Command="{Binding BrowseCommand}" />
      </Grid>
      <TextBlock Classes="error hint" Text="{Binding DirectoryError}" IsVisible="{Binding DirectoryError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Classes="hint" Text="{Binding FolderText}"
                 IsVisible="{Binding ShowFolderText}"
                 Classes.muted="{Binding !FolderWarning}" Classes.warning="{Binding FolderWarning}" Classes.error="{Binding FolderError}" />
    </StackPanel>

    <TextBlock Classes="error hint" Text="{Binding SaveError}" IsVisible="{Binding SaveError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
      <Button Content="Cancel" Command="{Binding CancelCommand}" />
      <Button Classes="accent" Content="{Binding SaveText}" Command="{Binding SaveCommand}" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
